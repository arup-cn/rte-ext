{
  "name": "rte-ext",
  "private": false,
  "version": "1.0.2",
  "description": "A custom extension for Remirror",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@remirror/pm": "^3.0.0",
    "@remirror/react": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remirror": "^3.0.1",
    "vite-plugin-dts": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Arup Dey",
  "license": "MIT"
}
